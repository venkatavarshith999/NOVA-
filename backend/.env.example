# Nova AI Backend - Environment Configuration
ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Database (SQLite by default for zero-config local/demo use.
# Swap to Postgres for production: postgresql://user:pass@host:5432/nova)
DATABASE_URL=sqlite:///./storage/nova.db

# Gemini — leave blank to run Nova AI on its built-in heuristic
# extraction + extractive-answer fallback (fully demoable, zero cost).
# Set a real key to enable live Gemini 2.5 Flash generation & embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Storage
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./storage/vectors
